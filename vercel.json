{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["hnd1"],
  "functions": {
    "api/*.ts": { "maxDuration": 120, "includeFiles": "server/scent-translation/**" }
  },
  "rewrites": [{ "source": "/((?!api(?:/|$)|assets/).*)", "destination": "/index.html" }]
}
