{
  "name": "scentlens",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/tokens.mjs",
    "check": "npm run typecheck && node scripts/tokens.mjs --check && node scripts/check-assets.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:fixture": "npm run check && vite build --mode native-fixture && playwright test --config playwright.fixture.config.ts",
    "test:translation": "vitest run tests/unit/translation.test.ts",
    "ios:doctor": "node scripts/ios.mjs doctor",
    "ios:sync": "node scripts/ios.mjs sync",
    "ios:sync:fixture": "node scripts/ios.mjs fixture",
    "ios:build:simulator": "node scripts/ios.mjs simulator",
    "ios:open": "cap open ios",
    "ios:sync:ble": "node scripts/ios.mjs ble",
    "dev:ble": "vite --mode ble-validation --host 127.0.0.1"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "dexie": "4.4.6",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/cli": "0.1.22",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
