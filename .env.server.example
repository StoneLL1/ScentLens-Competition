# Server-only. Use npm run setup:cloud and http://127.0.0.1:8787/__setup locally.
# Never prefix secrets with VITE_. Blank means not configured, not a free fallback.
INTERPRET_API_BASE_URL=
INTERPRET_API_KEY=
INTERPRET_MODEL=
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium
# At least 32 random characters each; setup creates these locally.
SCENT_ACCESS_KEY=
SCENT_SIGNING_KEY=
SCENT_ALLOWED_ORIGINS=https://your-project.vercel.app,capacitor://localhost
# Provider call units: interpret reserves 2; image reserves 1. UTC calendar day.
SCENT_DAILY_CALL_LIMIT=100
SCENT_MINUTE_CALL_LIMIT=30
# Required in Vercel; no memory-only fallback. Upstash Marketplace uses KV_* names:
# copy KV_REST_API_URL and KV_REST_API_TOKEN to these server-only variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
